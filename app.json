{
  "expo": {
    "name": "Judô Conde Koma",
    "slug": "judo-conde-koma",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "description": "App oficial da academia Judô Conde Koma - Treinos, graduações, técnicas e muito mais!",
    "githubUrl": "https://github.com/rafaelvalverdedev/app-judo",
    "primaryColor": "#000000",
    "scheme": "judo-conde-koma",
    "orientation": "portrait",
    "icon": "./assets/logo/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rafaelvalverde.judocondekoma",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Judô Conde Koma",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.rafaelvalverde.judocondekoma",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/icons/favicon.png",
      "name": "Judô Conde Koma",
      "shortName": "Judô App",
      "lang": "pt-BR",
      "scope": "/",
      "themeColor": "#000000",
      "description": "App oficial da academia Judô Conde Koma",
      "dir": "auto",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "extra": {
      "eas": {
        "projectId": "626ae467-7eb4-483f-9352-5d4e7fbabece"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-font"
    ],
    "owner": "rafaelvalverde",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/626ae467-7eb4-483f-9352-5d4e7fbabece"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}